{
  "name": "studiolucenti",
  "version": "1.0.0",
  "description": "Studio Lucenti WordPress Theme",
  "scripts": {
    "start": "concurrently \"wp-scripts start\" \"sass assets/css/style.scss assets/css/style.css --watch\"",
    "build": "wp-scripts build && sass assets/css/style.scss assets/css/style.css --style compressed",
    "lint:js": "wp-scripts lint-js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "concurrently": "^9.0.0",
    "sass": "^1.80.0"
  },
  "dependencies": {
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/head-plugin": "^2.3.1",
    "gsap": "^3.12.0",
    "hls.js": "^1.5.0",
    "lenis": "^1.3.0",
    "plyr": "^3.7.8",
    "simplelightbox": "^2.14.0",
    "swiper": "^12.2.0",
    "swup": "^4.9.2"
  }
}
